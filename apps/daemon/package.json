{
  "name": "@car/daemon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": { "car": "./dist/main.js" },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "check": "tsc --noEmit",
    "clean": "tsc -b tsconfig.build.json --clean",
    "dev": "pnpm run build && node --enable-source-maps dist/main.js",
    "start": "node --enable-source-maps dist/main.js",
    "test": "pnpm run build && node --test test/*.test.js"
  },
  "dependencies": {
    "@car/core": "workspace:*",
    "@car/defaults": "workspace:*",
    "@car/plugin-gitea": "workspace:*"
  }
}
